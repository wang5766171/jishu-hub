# 根目录点开头文件夹：忽略所有以 . 开头的目录（各类 AI / IDE / 工具的本地配置目录）。
# 锚定仓库根目录，不影响子目录，也不影响 .graphify_*.json 等点开头「文件」。
/.[!.]*/
# 例外：项目级共享目录，其新增内容仍需纳入版本管理（否则 /.[!.]*/ 会连新文件一并忽略）
!.github/
!.cargo/

# Build
/target
/dist

# Dependencies
/node_modules

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Graphify (internal tool)
.graphify
.graphify_python
.graphify_cached.json
.graphify_semantic_new.json
.graphify_uncached.txt
graphify-out

# Internal dev docs (local only, not tracked)
# screenshots 已移至仓库根目录 screenshots/，docs 整体忽略
docs/

# Local screenshots
*.png
!src-tauri/icons/*.png
!src/assets/*.png
!screenshots/*.png

# Runtime data
.jishu_hub/

# Claude Code project config
.claude/

# Agent git commit guide (local reference only)
agent-commit-guide.md

# Scratch / test artifacts
scratch/
.tmp/
check_log.txt
test_*.py
test_*.exe
test_*.pdb
test_*.rs
test_msg.json
test_session.jsonl

# Binaries / native artifacts
src-tauri/bin/

# Gemini local config
.gemini/
.kiro/
.codex
.opencode
CLAUDE.md
AGENTS.md
run-kiro.cmd
run-kiro.ps1

