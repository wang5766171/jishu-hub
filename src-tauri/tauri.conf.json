{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jishu Hub",
  "version": "0.5.4",
  "identifier": "com.jishu-hub.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node ./scripts/build.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Jishu Hub",
        "width": 1280,
        "height": 813,
        "center": true,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer.nsh",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
